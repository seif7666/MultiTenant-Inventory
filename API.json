  "components": {
    "schemas": {
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string"
          },
          "dealerId": {
            "type": "string",
            "format": "uuid",
            "minLength": 1
          },
          "model": {
            "type": "integer",
            "format": "int32",
            "maximum": 2030,
            "minimum": 200
          },
          "status": {
            "type": "string"
          },
          "priceMin": {
            "type": "number",
            "format": "double"
          },
          "priceMax": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "dealerId"
        ]
      },
      "Dealer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "subscriptionType": {
            "type": "string",
            "enum": [
              "BASIC",
              "PREMIUM"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "PageControl": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "type": "string"
          }
        }
      }
    }
  }
